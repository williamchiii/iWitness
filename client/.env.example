# Without these, the app falls back to mock Google sign-in (an instant,
# fake sign-in with no real Supabase or Google involved) — see
# client/src/lib/supabase.ts / lib/auth.ts.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-the-project-anon-key

# mock (default) or http — see client/src/lib/api/index.ts. http isn't
# implemented yet: most of docs/api_contract.md's endpoints don't exist on
# the backend (server/api.py) yet.
VITE_API_MODE=mock
