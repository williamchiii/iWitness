# Supabase session pooler (IPv4). Direct db.<ref>.supabase.co host is IPv6-only.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Use a relative path for media stored under server/.
MEDIA_ROOT=media
FFMPEG_BINARY=ffmpeg

# Required — must stay the same across restarts, or every playback URL
# already handed out becomes invalid. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PLAYBACK_SIGNING_SECRET=replace-with-a-long-random-secret

# How long a signed playback URL (playlist or segment) stays valid.
# Retention keeps a temporary segment on disk for this long past its
# normal buffer window, so a URL handed out just before the cutoff
# doesn't start 404ing before it expires.
PLAYBACK_URL_SECONDS=300

SEGMENT_SECONDS=10
BUFFER_SECONDS=300
PRE_TRIGGER_SECONDS=60
POST_TRIGGER_SECONDS=15
UNCLAIMED_INCIDENT_SECONDS=900
